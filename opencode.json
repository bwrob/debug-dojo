{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "bash": {
            "*": "ask",
            "uv run poe *": "allow",
            "uv run pytest *": "allow",
            "uv run ruff *": "allow",
            "uv run pyrefly *": "allow",
            "uv run complexipy *": "allow",
            "uv run tach *": "allow",
            "uv run rumdl *": "allow",
            "uv run typos *": "allow",
            "uv run taplo *": "allow",
            "uv run zizmor *": "allow",
            "uv run prek *": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "rm -rf /*": "deny",
            "git push --force*": "deny"
        }
    }
}
